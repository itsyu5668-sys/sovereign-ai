# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Required: Groq API key from https://console.groq.com
GROQ_API_KEY=

# Optional: defaults to openai/gpt-oss-120b
GROQ_MODEL=openai/gpt-oss-120b

# Optional: OpenCrater publisher key (ock_...) from https://opencrater.to dashboard.
# Without it, answers still work — just no Blip is appended.
OPENCRATER_PUBLISHER_KEY=

# Optional: free queries per user per day (default 50, same for everyone)
DAILY_FREE_QUERY_LIMIT=50

# Optional: listen port (default 3000)
PORT=3000

# Optional but recommended for production: Supabase quota persistence.
# Without these, quota falls back to quota-data.json (wiped on Render redeploys).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
